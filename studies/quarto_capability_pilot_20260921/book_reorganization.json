      "id": "ch01",
      "number": 1,
      "file": "01-training-geometry.qmd",
      "anchor": "ch-training-geometry",
      "title": "Geometry of network training",
      "introduction": "The parameterization, initialization and training metric determine the geometry of the evolving network. This chapter collects the exact finite identities, initialized representation geometry, tangent geometry, curvature, and model-specific reductions used by the later population and learning results.",
      "chunks": [
        "finite-dynamics.qmd@__start__",
        "special-data-limits.qmd@sec-docs-special-data-limits-l7982",
        "special-data-limits.qmd@sec-docs-special-data-limits-l24007",
