    {
      "id": "ch08",
      "number": 8,
      "file": "08-autonomous-computation.qmd",
      "anchor": "ch-autonomous-computation",
      "title": "Convergent autonomous computation",
      "introduction": "A finite closure becomes a justified computation only after initialization, discretization and limiting operations are controlled. The chapter distinguishes fixed-program refinement, continuous-time approximation, closure-order convergence and computation through the supported learning horizon.",
