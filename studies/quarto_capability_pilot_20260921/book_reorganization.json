      ]
    },
    {
      "id": "ch03",
      "number": 3,
      "file": "03-local-population.qmd",
      "anchor": "ch-local-population",
      "title": "Local population evolution and exact capture",
      "introduction": "Under the stated assumptions, actual network training has a unique, restartable population description on a common local interval. The results here combine the fixed-depth local construction, evolution over training laws, finite GF/GD identification, and the complete local three-layer arctangent model.",
      "chunks": [
        "global-nonlinear.qmd@sec-docs-global-nonlinear-l1803",
