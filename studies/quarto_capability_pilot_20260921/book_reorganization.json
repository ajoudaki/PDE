    {
      "id": "ch04",
      "number": 4,
      "file": "04-continuing-flows.qmd",
      "anchor": "ch-continuing-flows",
      "title": "Continuing nonlinear population flows",
      "introduction": "Structural estimates can extend a local population description to global time or to a prescribed learning horizon. The chapter places the two-layer coordinate transformations, special-angle two-input dynamics, changed-law continuation, and the order-one-readout limit side by side while retaining their different contracts.",
      "chunks": [
        "global-nonlinear.qmd@sec-docs-global-nonlinear-l1899",
