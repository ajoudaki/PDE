      ]
    },
    {
      "id": "ch05",
      "number": 5,
      "file": "05-continuation-boundaries.qmd",
      "anchor": "ch-continuation-boundaries",
      "title": "Compactness, regularity and continuation boundaries",
      "introduction": "The choice of state space and available estimates determines what a continuation argument can establish. This chapter separates positive compactness and continuation results from reached regularity failures, ambient constructions and auxiliary obstructions.",
