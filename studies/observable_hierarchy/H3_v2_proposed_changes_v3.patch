+def _tail_values(words, population, g, xi, reverse, core_actions, ar):
+    """Evaluate the small no-new-source tail on the complete core tuple."""
+    count = len(g) if population == 1 else len(xi)
+    zero = ar.zeros((count, 2))
+    one = ar.real(1)
