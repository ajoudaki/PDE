+    supervisor_path = runs_path/"supervisor.json"
+    if supervisor_path.is_file():
+        supervisor = json.loads(supervisor_path.read_text())
+        if supervisor.get("plan_sha256") != plan_hash:
+            raise ValueError("supervisor plan hash differs")
